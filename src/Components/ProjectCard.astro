---
import { type ProjectCollectionType } from "src/content/config";
import XmarkCircle from "src/assets/xmark-circle.astro";

export interface Props {
	project_page: ProjectCollectionType;
}

const { project_page } = Astro.props;
---

<div class="project-card">
	<button class="project-card-button">
		<h2>{project_page.title}</h2>
		<p>{project_page.description}</p>
	</button>
	<dialog class="project-card-dialog">
		<div class="title-container">
			<h2>{project_page.title}</h2>

			<button class="close-button">close <XmarkCircle /></button>
		</div>
		<p>{project_page.description}</p>
		<div class="grid-div">
			<p><span class="label">VCS</span> {project_page.repository_type}</p>
			<p>
				<span class="label">Platform</span>
				<a href={project_page.repository_page_url} target="_blank"
					>{project_page.repository_location}</a
				>
			</p>
			{
				project_page.tech_stack && (
					<p class="stack">
						<span class="label">Stack</span>
						{project_page.tech_stack.join(", ")}
					</p>
				)
			}
		</div>
	</dialog>
</div>

<style lang="scss">
	@use "src/styles/global";

	.close-button {
		border: none;
		border-radius: 1rem;
		// padding: 0px;
		transition-property: scale, background;
		transition-duration: 300ms;
		font-size: 2rem;

		background: global.$primary_color2;
		&:hover {
			background: global.$primary_color4;
		}
		&:active {
			background: global.$primary_color5;
		}
		:global(svg) {
			height:2rem;
			width:2rem;
			vertical-align: sub;
		}
	}

	.label {
		// color: white;
		background-color: global.$primary_color4;
		padding: 0.25rem;
		border-radius: 0.5rem;
		margin-right: 0.2rem;
	}

	.title-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	p.stack {
		grid-column: span 2;
		line-height: 2rem;
	}

	.project-card-button {
		color: black;
		text-decoration: inherit;
		display: block;
		width: 100%;
		border: 0;
		text-align: left;
		font-size: 1em;
		font-family: inherit;

		margin: 1rem;
		padding: 0.1rem 2rem;

		box-sizing: border-box;

		background: global.$primary_color3;
		border-radius: 1rem;
		@media (prefers-reduced-motion: no-preference) {
			transition-property: background, border-radius, scale;
			transition-duration: 300ms;
		}
		&:not(.hover-disabled){
			&:hover {
				background: global.$primary_color4;
				@media (prefers-reduced-motion: no-preference) {
					scale: 1.1;
				}
			}
			&:active {
				background: global.$primary_color5;
				@media (prefers-reduced-motion: no-preference) {
					scale: 1.02;
				}
			}
		}
	}

	.project-card-dialog {
		border: 0.5rem solid global.$primary_color2;
		background: global.$primary_color3;
		border-radius: 1rem;
		box-sizing: content-box;
		min-width: 60rem;
		// padding: 3rem;
		&::backdrop {
			background: rgba(0, 0, 0, 0.6);
			transition-duration: 100s;
		}
		&:hover {
			transition-duration: 100s;
		}
	}
	.grid-div {
		@media (min-width: 40em) {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			p {
				margin: 0.5rem 0;
			}
		}
	}
</style>

<script>
	const project_cards =
		document.querySelectorAll<HTMLDivElement>("div.project-card");
	for (const project_card of project_cards) {
		const project_card_dialog =
			project_card.querySelector<HTMLDialogElement>(
				"dialog.project-card-dialog",
			);
		const project_card_button =
			project_card.querySelector<HTMLButtonElement>(
				"button.project-card-button",
			);
		const project_card_close_button = 
			project_card.querySelector<HTMLButtonElement>("button.close-button")
		if (!(project_card_dialog && project_card_button && project_card_close_button)) {
			continue;
		}
		project_card_close_button.addEventListener("click", () => {
			project_card_dialog.close();
		})
		project_card_button.addEventListener("click", () => {
			project_card_dialog.showModal();
			project_card_button.classList.add("hover-disabled");
		});
		project_card_dialog.addEventListener("close", () => {
			project_card_button.classList.remove("hover-disabled");
		});
	}
</script>
