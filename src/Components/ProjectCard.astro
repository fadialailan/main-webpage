---
import { type ProjectCollectionType } from "src/content/config";
export interface Props {
	project_page: ProjectCollectionType;
}

const { project_page } = Astro.props;
---

<a class="project-card" href={project_page.repository_page_url} target="_blank">
	<h2>{project_page.title}</h2>
	<p>{project_page.description}</p>
	<div>
		<p><span class="label">VCS</span> {project_page.repository_type}</p>
		<p>
			<span class="label">Platform</span>
			{project_page.repository_location}
		</p>
		<p class="stack">
			<span class="label">Stack</span>C++, Cmake, CLI11, ImageMagick, FMT
		</p>
	</div>
</a>

<style lang="scss">
	@import "src/styles/global";

	.label {
		color: white;
		background-color: $primary_color5;
		padding: 0.25rem;
		border-radius: 0.5rem;
		margin-right: 0.2rem;
	}

	p.stack {
		grid-column: span 2;
		line-height: 2rem;
	}

	.project-card {
		color: black;
		text-decoration: inherit;
		display: block;
		border: 0;
		-webkit-appearance: none;

		// margin: 2rem;
		padding: 0.1rem 2rem;

		background: $primary_color3;
		@media (prefers-reduced-motion: no-preference) {
			transition-property: background, border-radius, scale;
			transition-duration: 300ms;
		}
		border-radius: 1rem;
		&:hover {
			@media (prefers-reduced-motion: no-preference) {
				scale: 1.1;
			}
			background: $primary_color4;
		}

		div {
			@media (min-width: 40em) {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				p {
					margin: 0.5rem 0;
				}
			}
		}
	}
</style>

