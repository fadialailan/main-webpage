---
// import { readFile } from "node:fs/promises";
import * as file from "node:fs"
import ProjectLayout from "src/Layouts/ProjectLayout.astro";
import { RepositoryType, RepositoryLocation } from "src/scripts/models";
export const title = "Pixel Art Scaler";
export const description = `
pixel-art-scaler is a tool to enlarge pixel art for platforms that blur it when you upload to them.
`;
export const repository_page_url =
	"https://github.com/fadialailan/pixel-art-scaler";
export const repository_type = RepositoryType.GIT_REPO;
export const repository_location = RepositoryLocation.GITHUB;



---

<ProjectLayout
	title={title}
	repository_page_url={repository_page_url}
	repository_type={repository_type}
	repository_location={repository_location}
/>
